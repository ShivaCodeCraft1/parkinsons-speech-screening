# Copy to .env (never commit .env). Values here are examples, not your real paths.
# Folder where you extracted the dataset (kept OUTSIDE this repository):
PD_DATA_ROOT=D:/datasets/Italian Parkinson's Voice and Speech
# Where trained model artifacts are stored / loaded from (default: models/current):
PD_MODEL_DIR=models/current
# Optional: enable the local demo-sample endpoints (reads recordings from PD_DATA_ROOT; never bundled):
PD_ENABLE_DEMO_MODE=0
# Optional: log level (DEBUG, INFO, WARNING)
PD_LOG_LEVEL=INFO
