# Data: never commit audio or participant-level data (the .gitkeep files are the only tracked items)
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.wav
*.zip

# Anything that can contain participant names or the pseudonymisation salt
**/private/
*PRIVATE*
subject_id_salt.txt

# Python / tooling
__pycache__/
*.pyc
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
mlruns/

# Environment / secrets
.env

# Generated by the pipeline (regenerate locally; do not commit participant-level outputs)
models/current/
models/*.joblib
reports/evaluation/
reports/training/
data/processed/*.csv

# Local datasets and secrets
.env.*
!.env.example
data/raw/
data/interim/
data/processed/

